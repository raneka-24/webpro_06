<!Doctype html>
<html>
<head><meta charset="utf-8"><title>打楽器編集</title></head>
<body>
  <h2>「<%= data.name %>」の編集</h2>
  <form action="/pacas/update/<%= id %>" method="POST">
    ローマ字の頭文字<br><input type="text" name="alfa" value="<%= data.alfa %>"><br>
    ローマ字<br><input type="text" name="romaji" value="<%= data.romaji %>"><br>
    名前<br><input type="text" name="name" value="<%= data.name %>"><br>
    属しているグループ<br><input type="text" name="group" value="<%= data.group %>"><br>
    発祥地<br><input type="text" name="region" value="<%= data.region %>"><br>
    <button type="submit">更新する</button>
  </form>
  <a href="/pacas/data/<%= id %>">詳細に戻る</a>
</body>
</html>